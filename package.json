{
  "name": "ponto-marine-shop",
  "version": "5.0.0",
  "description": "Ponto Marine Shop - sistema de controle de ponto (Cloudflare Workers + D1)",
  "main": "public/_worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply ponto-gaveta-pro-db --remote",
    "migrate:local": "wrangler d1 migrations apply ponto-gaveta-pro-db --local",
    "backup": "node scripts/backup.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "setup:biometria": "node scripts/instalar-biometria.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true
  }
}
