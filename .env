# Copie este arquivo para ".env" antes de rodar o projeto (cp .env.example .env)

# Porta em que o servidor vai rodar
PORT=3000

# Caminho do arquivo do banco SQLite (fica FORA da pasta public/, nunca é servido via HTTP)
DB_PATH=./data/ponto.db

# PIN administrativo inicial (4 a 8 digitos). So e usado na PRIMEIRA vez que o servidor sobe,
# para criar o hash salvo no banco. Depois disso, troque pela tela de Administracao
# (o valor aqui deixa de ter efeito assim que existir um hash salvo em "configuracoes").
ADMIN_PIN_INICIAL=1234

# Ambiente: development | production
NODE_ENV=development

# Reconhecimento facial (opcional): distancia maxima aceita entre o rosto capturado e uma
# amostra cadastrada. Menor = mais rigoroso. So mexa aqui se estiver reconhecendo errado
# ou recusando gente demais depois de testar. Padrao: 0.5
BIOMETRIA_LIMIAR=0.5

# Jornada mensal de referencia (em horas) usada para converter salario-base em valor-hora
# (salario / JORNADA_MENSAL_HORAS). 220h eh o padrao mais comum no Brasil (44h semanais).
JORNADA_MENSAL_HORAS=220
